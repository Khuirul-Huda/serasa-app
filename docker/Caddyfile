{
	{$CADDY_GLOBAL_OPTIONS}

	admin {$CADDY_SERVER_ADMIN_HOST:localhost}:{$CADDY_SERVER_ADMIN_PORT:2019}

	frankenphp {
		worker {
			file "{$APP_PUBLIC_PATH:/app/public}/frankenphp-worker.php"
			{$CADDY_SERVER_WORKER_DIRECTIVE}
			{$CADDY_SERVER_WATCH_DIRECTIVES}
		}
	}
}

{$CADDY_EXTRA_CONFIG}

{$CADDY_SERVER_SERVER_NAME:http://:8000} {
	log {
		level {$CADDY_SERVER_LOG_LEVEL:INFO}

		# Redact sensitive parameters from access logs
		format filter {
			wrap {$CADDY_SERVER_LOGGER:console}
			fields {
				uri query {
					replace authorization REDACTED
				}
			}
		}
	}

	# Compression (zstd > brotli > gzip)
	encode zstd br gzip

	# Security headers
	header {
		X-Content-Type-Options  "nosniff"
		X-Frame-Options         "SAMEORIGIN"
		X-XSS-Protection        "1; mode=block"
		Referrer-Policy         "strict-origin-when-cross-origin"
		Permissions-Policy      "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}

	# Immutable cache for hashed Vite build assets
	@vite_assets path /build/*
	header @vite_assets Cache-Control "public, max-age=31536000, immutable"

	# Static cache for public assets (favicons, images, fonts)
	@static_assets path *.ico *.svg *.png *.jpg *.jpeg *.gif *.webp *.woff *.woff2 *.ttf
	header @static_assets Cache-Control "public, max-age=86400, must-revalidate"

	route {
		root * "{$APP_PUBLIC_PATH:/app/public}"

		# Mercure / extra directives
		{$CADDY_SERVER_EXTRA_DIRECTIVES}

		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
