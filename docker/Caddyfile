{
	# FrankenPHP directive must be present — enables the PHP SAPI.
	# The worker lifecycle is managed by octane:frankenphp, NOT by
	# a `worker {}` block here. Adding a global worker block while
	# also using php_server causes double-worker registration.
	frankenphp

	admin off

	log {
		output stderr
		format json
		level  INFO
	}
}

:8000 {
	root * /app/public

	# Compression (zstd > brotli > gzip)
	encode {
		zstd
		br
		gzip 6
		minimum_length 1024
	}

	# Security headers
	header {
		X-Content-Type-Options  "nosniff"
		X-Frame-Options         "SAMEORIGIN"
		X-XSS-Protection        "1; mode=block"
		Referrer-Policy         "strict-origin-when-cross-origin"
		Permissions-Policy      "geolocation=(), microphone=(), camera=()"
		-Server
		-X-Powered-By
	}

	# Immutable cache for hashed Vite build assets
	@vite_assets path /build/*
	header @vite_assets Cache-Control "public, max-age=31536000, immutable"

	# php_server handles both PHP requests (via Octane worker) and
	# static file serving. Do NOT add a separate file_server directive
	# — php_server already falls back to static files, and having both
	# causes duplicate handling.
	php_server
}
