# ── Application ───────────────────────────────────────────────
APP_NAME="Serasa App"
APP_ENV=production
APP_KEY=                         # php artisan key:generate --show
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serasa
DB_USERNAME=serasa
DB_PASSWORD=secret               # change in production

POSTGRES_DB=serasa
POSTGRES_USER=serasa
POSTGRES_PASSWORD=secret         # change in production

# ── Cache / Session / Queue (Redis) ──────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # set a strong password in production
REDIS_CLIENT=phpredis

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

# ── Octane ────────────────────────────────────────────────────
OCTANE_SERVER=frankenphp

# ── Logging ───────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error

# ── Mail ──────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
