APP_NAME="Serasa App"
APP_ENV=production
APP_KEY=CHANGE_ME_RUN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://CHANGE_ME_YOUR_DOMAIN.com

# ── Docker & Server Setup ─────────────────────────────────────
APP_PORT=8000
RUN_MIGRATIONS=true
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── PostgreSQL Database Container ──────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serasa
DB_USERNAME=serasa
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

# ── Redis Container ───────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=serasa_cache

# ── Mail Configuration ────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (Optional) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME_OPTIONAL
AWS_SECRET_ACCESS_KEY=CHANGE_ME_OPTIONAL
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=CHANGE_ME_OPTIONAL
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
